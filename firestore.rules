// Site Main Control — Firestore 보안 규칙
// 현재 게시된 규칙 (관리자: buyeon.hwang@gmail.com)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail()  { return request.auth.token.email.lower(); }
    function isAdmin()  { return verified() && myEmail() in ['buyeon.hwang@gmail.com']; }

    // 사이트 정책: 누구나 읽기(가드가 확인), 관리자만 쓰기
    match /sites/{site} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 그룹: 인증된 회원 읽기, 관리자 쓰기
    match /groups/{g} {
      allow read: if verified();
      allow write: if isAdmin();
    }
    // 회원: 본인 문서만 읽기, 본인은 접속 시각만 갱신
    match /users/{email} {
      allow read: if isAdmin() || (verified() && myEmail() == email);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (verified() && myEmail() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'lastSite', 'visits']));
    }
    // 접속 기록: 누구나 형식에 맞게 추가, 관리자만 읽기·삭제
    match /logs/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['site', 'path', 'email', 'result', 'reason', 'ts', 'ua', 'ref'])
        && request.resource.data.site is string && request.resource.data.site.size() < 100
        && request.resource.data.path is string && request.resource.data.path.size() < 300
        && request.resource.data.result in ['visit', 'allowed', 'denied', 'admin']
        && (request.resource.data.email == 'anonymous' || (signedIn() && request.resource.data.email == myEmail()));
    }
    // 접근 요청: 인증된 본인만 생성, 관리자 처리
    match /requests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if verified() && request.resource.data.email == myEmail()
        && request.resource.data.message.size() <= 300;
    }
    // 🎙 말하기 연습(speak.js): 점수 — 본인만 쓰기(한 번에 +300 XP 이내), 로그인 회원은 순위표로 읽기
    function speakName() { return request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40; }
    function speakOk(prev) { return speakName() && request.resource.data.xp is int
      && request.resource.data.xp >= prev && request.resource.data.xp - prev <= 300; }
    match /speak_users/{uid} {
      allow read: if signedIn();
      allow create: if verified() && request.auth.uid == uid && speakOk(0);
      allow update: if verified() && request.auth.uid == uid && speakOk(resource.data.get('xp', 0));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    // 🎙 말하기 반: 인증 회원 누구나 만들기, 만든 사람·관리자만 수정·삭제
    match /speak_classes/{code} {
      allow read: if signedIn();
      allow create: if verified() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.owner == request.auth.uid && speakName();
      allow update: if verified() && (resource.data.owner == request.auth.uid || isAdmin())
        && request.resource.data.owner == resource.data.owner && speakName();
      allow delete: if verified() && (resource.data.owner == request.auth.uid || isAdmin());
      match /members/{uid} {
        allow read: if signedIn();
        allow create: if verified() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/speak_classes/$(code))
          && request.resource.data.xp == 0 && speakName();
        allow update: if verified() && request.auth.uid == uid && speakOk(resource.data.get('xp', 0));
        allow delete: if verified() && (request.auth.uid == uid || isAdmin()
          || get(/databases/$(database)/documents/speak_classes/$(code)).data.owner == request.auth.uid);
      }
    }
  }
}
